{
    "$schema": "node_modules/wrangler/config-schema.json",
    // Workers Builds (Settings > Build):
    //   Build command:  npx opennextjs-cloudflare build
    //   Deploy command: npx opennextjs-cloudflare deploy
    //   Non-production: npx opennextjs-cloudflare upload
    // `wrangler deploy` alone fails: it looks for .open-next from a prior OpenNext build.
    "main": ".open-next/worker.js",
    "name": "kyascenehai",
    "compatibility_date": "2026-08-30",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
      "directory": ".open-next/assets",
      "binding": "ASSETS"
    },
    "services": [
      {
        // Must match this Worker's name and the Cloudflare Pages project name
        "binding": "WORKER_SELF_REFERENCE",
        "service": "kyascenehai"
      }
    ]
  }